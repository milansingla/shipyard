{
  "name": "shipyard",
  "version": "0.2.0",
  "private": true,
  "description": "A small, understandable, self-hosted deployment platform.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "npm run dev -w @shipyard/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @shipyard/api",
    "shipyard": "npm run cli -w @shipyard/api --"
  }
}
