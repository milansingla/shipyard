{
  "name": "shipyard",
  "version": "4.0.0",
  "private": true,
  "description": "A small, understandable, self-hosted deployment platform.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "npm run dev -w @shipyard/api",
    "dev:web": "npm run dev -w @shipyard/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @shipyard/api",
    "shipyard": "npm run start -w @shipyard/cli --",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @shipyard/api",
    "db:deploy": "npm run db:deploy -w @shipyard/api",
    "db:studio": "npm run db:studio -w @shipyard/api",
    "shipyard:local": "npm run cli -w @shipyard/api --"
  }
}
