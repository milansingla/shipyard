// Shipyard database schema. See docs/database.md for the reasoning behind each model.
//
//   npm run db:migrate   create + apply a migration after editing this file
//   npm run db:studio    browse the data

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Must stay identical to DeploymentStatus in src/services/deployment/status.ts
/// (a unit test enforces this). The legal transitions live in that file, not here.
enum DeploymentStatus {
  QUEUED
  CLONING
  DETECTING
  BUILDING
  STARTING
  HEALTH_CHECKING
  HEALTHY
  ROUTING
  RUNNING
  FAILED
  STOPPING
  STOPPED
  /// An earlier deployment being brought back (rollback).
  ROLLING_BACK
}

/// What started a deployment.
enum DeploymentTrigger {
  /// Someone clicked Deploy / Redeploy (dashboard or API).
  MANUAL
  /// A GitHub push webhook.
  PUSH
}

/// A person who signed in with GitHub. GitHub is the only identity provider in V2.
model User {
  id                String    @id @default(uuid()) @db.Uuid
  kind              UserKind  @default(HUMAN)
  /// GitHub's numeric account id: stable, unlike `login`, which users can rename. null for service accounts.
  githubId          BigInt?   @unique
  login             String
  name              String?
  avatarUrl         String?
  /// AES-256-GCM ciphertext (see src/lib/secretBox.ts). Never returned by the API. null for service accounts.
  githubAccessToken String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  projectsCreated   Project[]
  memberships       Membership[]
  sessions          Session[]
  deploymentEvents  DeploymentEvent[]
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
  teams             TeamMember[]

  @@map("users")
}

enum UserKind {
  /// Signs in with GitHub.
  HUMAN
  /// An automation identity of one organization (CI, scripts): API keys only, never a session.
  SERVICE_ACCOUNT
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256
/// is stored here, so a database leak does not leak usable sessions.
model Session {
  /// sha256(token), hex.
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A repository + branch that Shipyard knows how to deploy.
model Project {
  id              String       @id @default(uuid()) @db.Uuid
  /// The team the project belongs to; access comes from membership in it.
  /// Restrict: deleting an organization must go through deleting its
  /// projects, which also removes containers.
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Who created it (informational; grants nothing).
  createdById     String?      @db.Uuid
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name            String
  /// URL/Docker-safe identifier derived from `name`. Used for container names
  /// and the project's hostname (<slug>.<SHIPYARD_PUBLIC_DOMAIN>).
  slug            String       @unique
  repositoryUrl   String
  repositoryOwner String
  repositoryName  String
  branch          String
  /// Path probed before a deployment counts as healthy. "/" accepts any status < 500;
  /// any other path requires 2xx/3xx.
  healthCheckPath String       @default("/")
  /// Port probed, if not the app's own port (e.g. a separate admin/metrics port).
  healthCheckPort Int?
  /// How long a new deployment has to become healthy; null = server default.
  healthCheckTimeoutSeconds Int?
  /// CPUs the app may use, e.g. 0.5; null = no limit.
  cpuLimit        Float?
  /// Memory in MB (swap disabled); null = no limit.
  memoryLimitMb   Int?
  restartPolicy   RestartPolicy @default(UNLESS_STOPPED)
  /// Build a preview for each pull request of a branch in this repository.
  previewDeployments Boolean   @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deployJobs   DeployJob[]
  deployments     Deployment[]
  environmentVariables EnvironmentVariable[]
  domains         ProjectDomain[]
  services        Service[]
  cronJobs     CronJob[]
  environments Environment[]
  teamGrants   TeamProjectGrant[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("projects")
}

enum OrgRole {
  /// Everything, including managing admins and owners.
  OWNER
  /// Settings, domains, deleting projects, managing developers and viewers.
  ADMIN
  /// Deploy, roll back, change variables, create projects.
  DEVELOPER
  /// Read only.
  VIEWER
}

/// A team that owns projects. Every user also has a personal organization.
model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  /// Unique, URL-safe. Personal organizations use "user-<login>".
  slug        String       @unique
  personal    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  memberships Membership[]
  projects    Project[]
  teams       Team[]
  notificationChannels NotificationChannel[]
  alerts      Alert[]

  @@map("organizations")
}

model Membership {
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole
  createdAt      DateTime     @default(now())

  @@id([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// A personal access token for the CLI and scripts. Only sha256(token) is
/// stored; the token itself is shown once, when it is created.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// First characters of the token ("shp_AbCd1234"), so people can tell keys apart.
  prefix     String
  /// sha256(token), hex.
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  /// Empty = everything its owner may do; otherwise "read", "deploy" or "write".
  scopes     String[]  @default([])

  @@index([userId])
  @@map("api_keys")
}

enum AuditAction {
  PROJECT_CREATED
  PROJECT_SETTINGS_CHANGED
  PROJECT_DELETED
  DEPLOYMENT_STARTED
  DEPLOYMENT_SUCCEEDED
  DEPLOYMENT_FAILED
  ROLLBACK
  ENV_VAR_SET
  ENV_VAR_DELETED
  DOMAIN_ADDED
  DOMAIN_REMOVED
  API_KEY_CREATED
  API_KEY_REVOKED
  ORGANIZATION_CREATED
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  SERVICE_CREATED
  SERVICE_CHANGED
  SERVICE_DELETED
  VOLUME_CREATED
  VOLUME_DELETED
  CRON_JOB_CREATED
  CRON_JOB_CHANGED
  CRON_JOB_DELETED
  CRON_JOB_RUN
  TEAM_CREATED
  TEAM_CHANGED
  TEAM_DELETED
  SERVICE_ACCOUNT_CREATED
  SERVICE_ACCOUNT_DELETED
}

/// Who did what, append-only. Kept when the project is deleted (no foreign
/// key to it): the name is copied so the trail stays readable.
model AuditLog {
  id          Int         @id @default(autoincrement())
  action      AuditAction
  /// null = Shipyard itself (a push, a background deploy finishing).
  actorId     String?     @db.Uuid
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  projectId   String?     @db.Uuid
  projectName String?
  /// The organization the entry belongs to (the project's, or the actor's
  /// personal one for account-level actions). Decides visibility, also after
  /// the project is deleted.
  organizationId String?  @db.Uuid
  /// Details, never secret values: deployment id, variable name, hostname…
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())

  @@index([projectId, id])
  @@index([organizationId, id])
  @@index([actorId, id])
  @@map("audit_logs")
}

/// What Docker does when a running app's process exits.
enum RestartPolicy {
  /// Leave it stopped.
  NO
  /// Restart after a crash (non-zero exit), up to 5 times.
  ON_FAILURE
  /// Always restart, also after a reboot, until Shipyard stops it.
  UNLESS_STOPPED
}

/// A custom hostname routed to the project's live deployment, next to its
/// generated <slug>.<SHIPYARD_PUBLIC_DOMAIN> address.
model ProjectDomain {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Lower-case. Unique across all projects: one hostname, one app.
  hostname  String   @unique
  /// The web service it routes to; null = the project's primary web service.
  serviceId String?  @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_domains")
}

/// Persistent data for a service: a Docker named volume mounted at `mountPath`.
/// It outlives every container, so redeploys and rollbacks keep the data.
/// Deleting it (or its service or project) always needs an explicit request.
model Volume {
  id        String   @id @default(uuid()) @db.Uuid
  serviceId String   @db.Uuid
  /// Restrict: the database refuses to drop a volume's row behind Shipyard's back.
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  /// Lowercase label, unique within the service.
  name      String
  /// Absolute path inside the container, e.g. /app/uploads.
  mountPath String
  /// Name of the Docker volume.
  dockerName String  @unique
  createdAt DateTime @default(now())

  @@unique([serviceId, name])
  @@unique([serviceId, mountPath])
  @@map("volumes")
}

enum ServiceSource {
  DASHBOARD
  CONFIG_FILE
}

enum ServiceType {
  /// Serves HTTP on its port: health-checked over HTTP, routable.
  WEB
  /// Background process: healthy when it keeps running; never routed.
  WORKER
  /// A PostgreSQL server from the official image, on a volume; private, never built from the repository.
  POSTGRES
}

/// One part of a project (frontend, backend, worker…), built from a
/// directory of the repository and deployed as its own container. Services of
/// a project reach each other by name (http://backend:3000) on a private
/// network; only public web services are reachable from outside.
model Service {
  id           String      @id @default(uuid()) @db.Uuid
  projectId    String      @db.Uuid
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// DNS label: its hostname inside the project network.
  name         String
  type         ServiceType @default(WEB)
  /// Directory to build, relative to the repository root.
  sourceDir    String      @default(".")
  /// Override detection (used with a generated Dockerfile).
  buildCommand String?
  /// Override the start command (also with the repository's Dockerfile).
  startCommand String?
  /// Override the detected port (web services).
  port         Int?
  /// Routed from outside. Only for web services.
  public       Boolean     @default(true)
  /// Prebuilt image it runs instead of building the repository (POSTGRES: postgres:<major>-alpine).
  image        String?
  /// Identical containers per deployment, load-balanced; 1–10. Always 1 for databases.
  replicas     Int         @default(1)
  /// Per-service overrides of the project's settings; null = the project's.
  healthCheckPath String?
  healthCheckPort Int?
  healthCheckTimeoutSeconds Int?
  cpuLimit     Float?
  memoryLimitMb Int?
  /// Who declared it: the dashboard/API, or the repository's shipyard.yaml.
  managedBy    ServiceSource @default(DASHBOARD)
  /// Settings changed in the dashboard: shipyard.yaml no longer overwrites them.
  overrides    String[]    @default([])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deployments  Deployment[]
  domains      ProjectDomain[]
  volumes      Volume[]
  cronJobs     CronJob[]

  @@unique([projectId, name])
  @@map("services")
}

/// A command run on a schedule in a short-lived container of a service's
/// live image, with its variables, on the project network.
model CronJob {
  id             String     @id @default(uuid()) @db.Uuid
  projectId      String     @db.Uuid
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId      String     @db.Uuid
  service        Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// Lowercase label, unique within the project.
  name           String
  /// 5-field cron expression or macro, UTC.
  schedule       String
  /// One line, run with `sh -c`.
  command        String
  enabled        Boolean    @default(true)
  timeoutSeconds Int        @default(3600)
  /// When it fires next; null while disabled. Claimed with a conditional update, so it runs once.
  nextRunAt      DateTime?
  managedBy      ServiceSource @default(DASHBOARD)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  runs           CronRun[]

  @@unique([projectId, name])
  @@index([enabled, nextRunAt])
  @@map("cron_jobs")
}

enum CronRunStatus {
  RUNNING
  SUCCEEDED
  /// Exited non-zero, or couldn't start.
  FAILED
  /// Killed after timeoutSeconds.
  TIMED_OUT
  /// Not started: the previous run was still going, or nothing is deployed.
  SKIPPED
}

enum CronRunTrigger {
  SCHEDULE
  MANUAL
}

model CronRun {
  id            String         @id @default(uuid()) @db.Uuid
  cronJobId     String         @db.Uuid
  cronJob       CronJob        @relation(fields: [cronJobId], references: [id], onDelete: Cascade)
  status        CronRunStatus  @default(RUNNING)
  trigger       CronRunTrigger @default(SCHEDULE)
  /// The deployment whose image it ran.
  deploymentId  String?        @db.Uuid
  scheduledFor  DateTime?
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  exitCode      Int?
  /// The last 64 KB of its output (stdout and stderr).
  output        String         @default("")
  errorMessage  String?
  containerName String?

  @@index([cronJobId, startedAt])
  @@map("cron_runs")
}

/// When a variable is available: to the running app, to `docker build`, or both.
enum EnvironmentVariableTarget {
  RUNTIME
  BUILD
  BOTH
}

/// A project's environment variable. The value is ALWAYS stored encrypted
/// (SecretBox, bound to project + key). `secret` only decides whether the API
/// ever shows the value again; secrets are runtime-only (build args end up in
/// image history).
model EnvironmentVariable {
  id        String                    @id @default(uuid()) @db.Uuid
  projectId String                    @db.Uuid
  project   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "project" = every service; otherwise a service id, whose value wins for that service.
  scope     String                    @default("project")
  key       String
  /// SecretBox ciphertext ("v1:…"), never plaintext.
  value     String
  secret    Boolean                   @default(false)
  target    EnvironmentVariableTarget @default(RUNTIME)
  /// Which environments get it. A secret set for ALL is a production secret:
  /// previews only get secrets set for PREVIEW.
  environment VariableEnvironment     @default(ALL)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@unique([projectId, scope, environment, key])
  @@map("environment_variables")
}

/// One attempt to build and run a project at a specific commit. Never updated
/// to point at a different commit: a redeploy creates a new row, which is
/// what makes history and rollback possible.
model Deployment {
  id            String           @id @default(uuid()) @db.Uuid
  projectId     String           @db.Uuid
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The service this deployment runs. Every deployment has one (the
  /// multi-service migration gave older ones their project's "web" service).
  serviceId     String           @db.Uuid
  service       Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// null = production. Otherwise a development environment or a pull request's preview.
  environmentId String?          @db.Uuid
  environment   Environment?     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  status        DeploymentStatus @default(QUEUED)
  trigger       DeploymentTrigger @default(MANUAL)
  /// Branch at the time of deployment (the project's branch may change later).
  branch        String
  commitSha     String?
  imageName     String?
  containerName String?
  containerId   String?
  containerPort Int?
  hostPort      Int?
  /// Identical containers this deployment runs (load-balanced). The first is containerName/containerId.
  replicas      Int       @default(1)
  /// Each replica's published port on its worker, in replica order (Traefik reaches remote workers through them).
  hostPorts     Int[]     @default([])
  /// The worker whose Docker runs (or ran) its containers.
  workerId      String?          @db.Uuid
  worker        Worker?          @relation(fields: [workerId], references: [id], onDelete: SetNull)
  deploymentUrl String?
  errorMessage  String?
  /// The stage a FAILED deployment was in when it failed.
  failedStage   DeploymentStatus?
  createdAt     DateTime         @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime         @updatedAt

  events        DeploymentEvent[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([serviceId, createdAt(sort: Desc)])
  @@index([environmentId, createdAt(sort: Desc)])
  @@index([status])
  @@map("deployments")
}

/// Which environments a variable applies to.
enum VariableEnvironment {
  ALL
  PRODUCTION
  PREVIEW
  DEVELOPMENT
}

enum EnvironmentType {
  /// One per project: a long-lived copy tracking another branch, at dev-<slug>.
  DEVELOPMENT
  /// One per pull request, at pr-<number>-<slug>; removed when the PR closes.
  PREVIEW
}

enum EnvironmentStatus {
  ACTIVE
  /// Its containers are gone (PR closed, or deleted); its deployments stay as history.
  CLOSED
}

/// An environment besides production (which is the project itself). Runs the
/// project's web services and workers from another branch, without its
/// databases, volumes, custom domains or production secrets.
model Environment {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @db.Uuid
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        EnvironmentType
  /// "dev" or "pr-<number>": the first part of its hostnames.
  name        String
  branch      String
  pullRequest Int?
  /// The pull request's title, for display.
  title       String?
  status      EnvironmentStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  closedAt    DateTime?
  deployJobs  DeployJob[]
  deployments Deployment[]

  @@unique([projectId, name])
  @@map("environments")
}

enum DeploymentEventType {
  /// The deployment was created (by a person, or by a push).
  CREATED
  STATUS_CHANGED
  /// Traffic moved back to an earlier deployment (recorded on both deployments).
  ROLLBACK
}

/// A deployment's history: written in the same transaction as each change,
/// so the timeline and the deployment's status can't disagree.
model DeploymentEvent {
  /// Auto-increment: orders events exactly, even within the same millisecond.
  id           Int                 @id @default(autoincrement())
  deploymentId String              @db.Uuid
  deployment   Deployment          @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  type         DeploymentEventType
  fromStatus   DeploymentStatus?
  toStatus     DeploymentStatus?
  /// The person whose action caused it; null when Shipyard acted on its own
  /// (the pipeline, a push, startup recovery).
  actorId      String?             @db.Uuid
  actor        User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  message      String?
  /// ROLLBACK: the other deployment (rolled back to / from).
  relatedDeploymentId String?      @db.Uuid
  createdAt    DateTime            @default(now())

  @@index([deploymentId, id])
  @@map("deployment_events")
}

/// Every GitHub webhook delivery Shipyard accepted, keyed by GitHub's delivery
/// id. GitHub retries and redelivers with the same id, so inserting first makes
/// processing idempotent: a duplicate insert means "already handled".
model WebhookDelivery {
  /// X-GitHub-Delivery (a GUID).
  id         String   @id
  event      String
  /// Human-readable result, e.g. "deployed crop-prices-api; queued agrowatch".
  outcome    String?
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("webhook_deliveries")
}

enum WorkerStatus {
  /** Heartbeating; gets new work. */
  ONLINE
  /** Heartbeating, but gets no new work: finishing what it has, to be taken out. */
  DRAINING
  /** Missed its heartbeats (or said goodbye). */
  OFFLINE
}

/// A machine that runs deployments with its own Docker. The control plane
/// runs one itself (`builtIn`); others register with the join token.
model Worker {
  id              String       @id @default(uuid()) @db.Uuid
  /// DNS label, unique: re-registering with the same name replaces its secret.
  name            String       @unique
  hostname        String
  /// Where the control plane and Traefik reach its published ports; null for the built-in worker (this machine).
  address         String?
  cpus            Float
  memoryMb        Int
  version         String
  status          WorkerStatus @default(ONLINE)
  /// sha256 of its secret (`shpw_…`); null for the built-in worker, which has none.
  tokenHash       String?      @unique
  builtIn         Boolean      @default(false)
  /// Deployment batches it is running, as of its last heartbeat.
  runningJobs     Int          @default(0)
  /// Runs deploy jobs (the built-in worker, and agents that said so when registering).
  acceptsJobs     Boolean      @default(false)
  /// Free space on its Docker disk, %, as of its last heartbeat (null = not reported).
  diskFreePercent Float?
  lastHeartbeatAt DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  jobs            DeployJob[]
  deployments     Deployment[]
  calls           WorkerCall[]

  @@index([status, lastHeartbeatAt])
  @@map("workers")
}

enum DeployJobStatus {
  /// Waiting for a worker (and for any running job of the same project environment).
  QUEUED
  /// Claimed by a worker, which holds a lease on it.
  RUNNING
  SUCCEEDED
  /// At least one of its deployments failed, or its worker was lost.
  FAILED
  /// Cancelled while still queued.
  CANCELLED
}

/// One deploy request in the durable queue: its deployments run in order on one worker.
model DeployJob {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @db.Uuid
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId  String?         @db.Uuid
  environment    Environment?    @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  /// The project id, or project/environment: at most one RUNNING job per key
  /// (a partial unique index in the migration).
  lockKey        String
  deploymentIds  String[]        @db.Uuid
  /// shipyard.yaml notes for the build log.
  notes          String[]        @default([])
  trigger        DeploymentTrigger
  /// Higher first: a person waiting beats a push.
  priority       Int             @default(0)
  status         DeployJobStatus @default(QUEUED)
  /// Picked by the scheduler; null until then.
  workerId       String?         @db.Uuid
  worker         Worker?         @relation(fields: [workerId], references: [id], onDelete: SetNull)
  /// While RUNNING: the worker's claim, renewed by its heartbeats. Past it, the worker is lost.
  leaseExpiresAt DateTime?
  attempts       Int             @default(0)
  /// The job this one retries after its worker was lost.
  retryOfId      String?         @db.Uuid
  error          String?
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([status, priority(sort: Desc), createdAt])
  @@index([lockKey, status])
  @@map("deploy_jobs")
}

enum WorkerCallStatus {
  /// Waiting for the worker to pick it up.
  PENDING
  /// The worker is running it.
  TAKEN
  DONE
  FAILED
}

/// An engine operation (run, stop, restart, logs…) the control plane asks a
/// worker to perform on its Docker. Workers long-poll for them over HTTPS.
model WorkerCall {
  id         String           @id @default(uuid()) @db.Uuid
  workerId   String           @db.Uuid
  worker     Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  method     String
  args       Json
  status     WorkerCallStatus @default(PENDING)
  result     Json?
  /// {code, message} when FAILED.
  error      Json?
  createdAt  DateTime         @default(now())
  takenAt    DateTime?
  finishedAt DateTime?

  @@index([workerId, status, createdAt])
  @@map("worker_calls")
}

/// A running deployment's resource use, sampled every 30 s and kept 24 h
/// (the dashboard's charts and the CPU/memory alerts read them).
model MetricSample {
  id            BigInt   @id @default(autoincrement())
  deploymentId  String   @db.Uuid
  projectId     String   @db.Uuid
  serviceId     String   @db.Uuid
  /// Sum over its replicas; 100 = one full CPU.
  cpuPercent    Float
  memoryMb      Float
  /// null = no limit.
  memoryLimitMb Float?
  restartCount  Int
  /// Replicas running when sampled.
  running       Int
  at            DateTime @default(now())

  @@index([projectId, at])
  @@index([deploymentId, at])
  @@index([at])
  @@map("metric_samples")
}

enum NotificationChannelType {
  /// POSTs a JSON alert to a URL.
  WEBHOOK
  /// A Slack incoming webhook.
  SLACK
}

/// Where an organization's alerts are sent. organizationId null = the
/// platform's own channel (worker alerts), managed by SHIPYARD_ADMINS.
model NotificationChannel {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String?                 @db.Uuid
  organization   Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           NotificationChannelType
  /// SecretBox ciphertext: a Slack webhook URL is a credential.
  url            String
  /// The URL's host, shown instead of the URL.
  host           String
  enabled        Boolean                 @default(true)
  lastError      String?
  lastSentAt     DateTime?
  createdAt      DateTime                @default(now())

  @@index([organizationId])
  @@map("notification_channels")
}

enum AlertKind {
  DEPLOYMENT_FAILED
  /// A RUNNING deployment's app isn't running (crashed, crash-looping).
  APP_DOWN
  WORKER_OFFLINE
  HIGH_CPU
  HIGH_MEMORY
  DISK_PRESSURE
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  RESOLVED
}

/// Something wrong, once: an open alert with the same fingerprint is reused
/// (a partial unique index in the migration), and channels hear about it when
/// it opens and when it resolves.
model Alert {
  id             String        @id @default(uuid()) @db.Uuid
  /// null = a platform alert (workers).
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?       @db.Uuid
  kind           AlertKind
  severity       AlertSeverity
  /// What it is about, e.g. "HIGH_CPU:<deployment id>".
  fingerprint    String
  title          String
  message        String
  status         AlertStatus   @default(OPEN)
  openedAt       DateTime      @default(now())
  resolvedAt     DateTime?

  @@index([organizationId, status, openedAt(sort: Desc)])
  @@index([fingerprint, status])
  @@map("alerts")
}

/// A group of an organization's members, granted roles on specific projects.
/// A member's role on a project is the higher of their organization role and
/// their teams' grants on it.
model Team {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime           @default(now())
  members        TeamMember[]
  grants         TeamProjectGrant[]

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMember {
  teamId String @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamProjectGrant {
  teamId    String  @db.Uuid
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Never OWNER: owning is an organization role.
  role      OrgRole

  @@id([teamId, projectId])
  @@index([projectId])
  @@map("team_project_grants")
}
