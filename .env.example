# ─────────────────────────────────────────────────────────────
# Shipyard environment configuration
# Copy to .env (git-ignored) and adjust. Empty values fall back to the default.
# Every variable is validated at startup by apps/api/src/config/env.ts.
# ─────────────────────────────────────────────────────────────

# Runtime mode: development | test | production.
# production hides internal error details from API responses and disables pretty logs.
NODE_ENV=development

# Address and port the Shipyard API listens on.
# Keep HOST=127.0.0.1 until authentication exists (Milestone 4): anyone who can
# reach the API can deploy arbitrary code on this machine.
HOST=127.0.0.1
PORT=4000

# PostgreSQL connection string. Required by the API server (not by the CLI).
# Matches the database in docker-compose.yml (`npm run db:up`).
DATABASE_URL=postgresql://shipyard:shipyard@127.0.0.1:5433/shipyard

# Log verbosity: fatal | error | warn | info | debug | trace | silent.
# The CLI defaults to "error" unless this is set explicitly.
LOG_LEVEL=info

# Where repositories are cloned before building. Each deployment gets its own
# subdirectory, which is deleted as soon as the image is built.
# Default: <os temp dir>/shipyard/workspaces
SHIPYARD_WORKSPACE_DIR=

# Comma-separated list of git hosts Shipyard may clone from (HTTPS only).
SHIPYARD_ALLOWED_GIT_HOSTS=github.com

# Persistent Shipyard data (build logs). Default: ~/.shipyard
SHIPYARD_DATA_DIR=

# Interface that deployed containers publish their port on.
# 127.0.0.1 (default) = reachable only from this machine.
# 0.0.0.0             = reachable from your network. Only use if you understand the exposure.
SHIPYARD_PUBLISH_HOST=127.0.0.1

# How long to wait for a new container to answer HTTP before marking it FAILED.
SHIPYARD_HEALTHCHECK_TIMEOUT_MS=60000

# Maximum time a git clone may take before it is killed.
SHIPYARD_GIT_CLONE_TIMEOUT_MS=120000

# Maximum time a docker build may take before it is cancelled (default 15 min).
SHIPYARD_BUILD_TIMEOUT_MS=900000

# Docker connection: Dockerode reads DOCKER_HOST automatically when set,
# otherwise it uses the default local socket.
# DOCKER_HOST=

# ── Coming in later milestones (not read yet) ───────────────
# GITHUB_CLIENT_ID=        # GitHub OAuth
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=
# GITHUB_WEBHOOK_SECRET=   # Webhook signature verification
# SHIPYARD_PUBLIC_DOMAIN=  # Traefik routing
