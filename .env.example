# ─────────────────────────────────────────────────────────────
# Shipyard environment configuration
# Copy to .env (git-ignored) and adjust. Empty values fall back to the default.
# Every variable is validated at startup by apps/api/src/config/env.ts.
# ─────────────────────────────────────────────────────────────

# Runtime mode: development | test | production.
# production hides internal error details from API responses and disables pretty logs.
NODE_ENV=development

# Address and port the Shipyard API listens on.
# Signed-in users deploy arbitrary code on this machine. Keep HOST=127.0.0.1
# unless the API sits behind HTTPS and only people you trust can sign in.
HOST=127.0.0.1
PORT=4000

# PostgreSQL connection string. Required by the API server (not by the CLI).
# Matches the database in docker-compose.yml (`npm run db:up`).
DATABASE_URL=postgresql://shipyard:shipyard@127.0.0.1:5433/shipyard

# Log verbosity: fatal | error | warn | info | debug | trace | silent.
# The CLI defaults to "error" unless this is set explicitly.
LOG_LEVEL=info

# Where repositories are cloned before building. Each deployment gets its own
# subdirectory, which is deleted as soon as the image is built.
# Default: <os temp dir>/shipyard/workspaces
SHIPYARD_WORKSPACE_DIR=

# Comma-separated list of git hosts Shipyard may clone from (HTTPS only).
SHIPYARD_ALLOWED_GIT_HOSTS=github.com

# Persistent Shipyard data (build logs). Default: ~/.shipyard
SHIPYARD_DATA_DIR=

# Interface that deployed containers publish their port on.
# 127.0.0.1 (default) = reachable only from this machine.
# 0.0.0.0             = reachable from your network. Only use if you understand the exposure.
# With SHIPYARD_PUBLIC_DOMAIN set it must be 127.0.0.1: visitors come in through
# Traefik, and the published port is only for Shipyard's own health checks.
SHIPYARD_PUBLISH_HOST=127.0.0.1

# How long to wait for a new container to answer HTTP before marking it FAILED.
# Default for every project; each project can set its own (Settings → Health check).
SHIPYARD_HEALTHCHECK_TIMEOUT_MS=60000

# Maximum time a git clone may take before it is killed.
SHIPYARD_GIT_CLONE_TIMEOUT_MS=120000

# Maximum time a docker build may take before it is cancelled (default 15 min).
SHIPYARD_BUILD_TIMEOUT_MS=900000

# Docker connection: Dockerode reads DOCKER_HOST automatically when set,
# otherwise it uses the default local socket.
# DOCKER_HOST=

# ── GitHub sign-in ───────────────────────────────────────────
# Without these, project and deployment endpoints answer 503.
# 1. GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#    Homepage URL:               http://localhost:3000
#    Authorization callback URL: <SHIPYARD_PUBLIC_URL>/api/auth/github/callback
#                                (with the values below: http://localhost:3000/api/auth/github/callback)
# 2. Copy the client ID, generate a client secret, paste both here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Who may sign in: your GitHub login(s), comma-separated. Required with GitHub
# sign-in, because anyone who signs in can run code on this machine.
# "*" allows ANY GitHub account — only for an isolated test server.
SHIPYARD_ALLOWED_GITHUB_USERS=

# Encrypts GitHub tokens stored in PostgreSQL. Required with GitHub sign-in.
# Generate once:  openssl rand -base64 32
# Changing it later only forces users to sign in again.
SHIPYARD_SECRET_KEY=

# Where browsers reach the API (the OAuth callback is built from it).
# Browsers go through the dashboard, which proxies /api to the API, so this is
# the dashboard's URL. https:// also turns on Secure cookies.
# Default without a dashboard: http://localhost:<PORT>
SHIPYARD_PUBLIC_URL=http://localhost:3000

# Where the browser lands after signing in (the dashboard).
# Also an origin allowed to make state-changing requests. Default: SHIPYARD_PUBLIC_URL
SHIPYARD_APP_URL=http://localhost:3000

# How long a sign-in lasts (default 720 = 30 days).
SHIPYARD_SESSION_TTL_HOURS=720

# ── Dashboard (apps/web) ────────────────────────────────────
# Where the dashboard's server reaches the API. Read by apps/web/next.config.ts
# from its own environment. Default: http://127.0.0.1:4000
# SHIPYARD_API_URL=

# ── Deploy on push (GitHub webhooks) ────────────────────────
# Shared secret GitHub signs every webhook delivery with (HMAC-SHA256).
# Generate once: openssl rand -hex 32 — and paste the SAME value as the
# webhook's "Secret" in each repository's Settings → Webhooks.
# Unset = push deploys disabled (the endpoint answers 503).
GITHUB_WEBHOOK_SECRET=

# ── Routing (Traefik) ───────────────────────────────────────
# Serve each project at http://<project-slug>.<domain> through Traefik, with
# zero-downtime redeploys. "localhost" works with no DNS setup: every
# *.localhost name points at this machine. Start Traefik with `npm run db:up`.
# Unset = no Traefik: each deployment gets its own http://localhost:<port> URL.
SHIPYARD_PUBLIC_DOMAIN=localhost

# Port Traefik listens on (127.0.0.1 only). Read by docker-compose.yml AND the
# API, so change it here, then `npm run db:up` again. Not 80 → URLs carry the
# port, e.g. http://myapp.localhost:8000. Default 80.
SHIPYARD_HTTP_PORT=

# Note: Traefik reads routes from <SHIPYARD_DATA_DIR>/traefik. If you set
# SHIPYARD_DATA_DIR above, use an absolute path: the API and docker-compose
# must resolve it to the same directory.
